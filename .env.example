# Copy to .env locally. Never paste credentials into chat or commit .env.
# Choose one provider. The runtime will validate availability before starting.
SPECULATE_PROVIDER=openai
SPECULATE_MODEL=
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Local server only; paid runs must have bounded calls and timeouts.
PORT=4317

# Vercel only: a private demo access code (at least 16 characters).
# Keep this separate from the provider API key. Give it only to intended demo users.
SPECULATE_RUN_TOKEN=
